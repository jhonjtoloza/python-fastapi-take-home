{
  "info": {
    "name": "Coffee Health API",
    "description": "Requests for the coffee health take-home API. Start it with `make db-reset && make load && make dev`; `baseUrl` defaults to http://localhost:8000. Run the folders in order: \"Next page\" uses the cursor saved by \"First page\".",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "cursor",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"database is ok\", () => pm.expect(body.database).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Pagination",
      "item": [
        {
          "name": "First page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/records?limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "records"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Saves `next_cursor` for the next request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"at most 5 items\", () => pm.expect(body.items.length).to.be.at.most(5));",
                  "pm.test(\"returns a cursor\", () => pm.expect(body.next_cursor).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"cursor\", body.next_cursor);",
                  "pm.collectionVariables.set(\"lastId\", body.items[body.items.length - 1].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Next page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/records?limit=5&cursor={{cursor}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "records"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "cursor",
                  "value": "{{cursor}}"
                }
              ]
            },
            "description": "Uses the cursor saved by the previous request; run it again to keep paging."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const lastId = Number(pm.collectionVariables.get(\"lastId\"));",
                  "pm.test(\"continues after the previous page\", () => pm.expect(body.items[0].id).to.be.above(lastId));",
                  "pm.collectionVariables.set(\"cursor\", body.next_cursor || \"\");",
                  "if (body.items.length) pm.collectionVariables.set(\"lastId\", body.items[body.items.length - 1].id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
